{
  "expo": {
    "name": "Homatri Rider",
    "slug": "homatri-rider",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FBF9F6"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.homatri.rider"
    },
    "android": {
      "package": "com.homatri.rider",
      "permissions": ["location"]
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Homatri Rider uses your location to track deliveries while you are on shift."
        }
      ]
    ]
  }
}
